PORT=8000
DATABASE_URL=postgres://saveria:saveria@localhost:5432/saveria
DATABASE_URL_TEST=postgres://saveria:saveria@localhost:5432/saveria_test
REDIS_URL=redis://localhost:6379
# Mínimo 32 bytes aleatorios. Generar con: openssl rand -base64 48
JWT_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
# dev-outbox escribe los correos como archivos en apps/api/.dev-outbox/; resend los envía de verdad
EMAIL_PROVIDER=dev-outbox
RESEND_API_KEY=
EMAIL_FROM=Saveria <no-reply@example.com>
# 0 = usar la IP del socket. N > 0 = tomar la N-ésima IP desde la derecha de X-Forwarded-For
TRUSTED_PROXY_HOPS=0
# La imagen Docker trae production. En production la API no arranca sin EMAIL_PROVIDER=resend
# y sin https en PUBLIC_BASE_URL.
NODE_ENV=development
